# Chaves de API opcionais para o Bira Flow.
# Copie para %APPDATA%\BiraFlow\.env (o install.ps1 faz isso) ou deixe como .env na pasta do projeto.
# Sem nenhuma chave tudo roda offline: whisper.cpp local, sem limpeza por LLM.
#
# Transcrição pela API: settings.toml -> [transcription] engine = "groq" | "openai" | "auto"
# Limpeza do texto por LLM: [cleanup] provider = "auto" usa a primeira chave: Groq, OpenAI, Anthropic

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
